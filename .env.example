# ---- X API (obrigatório) ----
# Bearer token do app no portal developer.x.com (tier pago: Basic ou Pro).
X_BEARER_TOKEN=

# ---- Telegram (obrigatório se alerts.telegram = true) ----
# Token do bot criado via @BotFather e chat_id do destino
# (descubra o chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Discord (opcional, se alerts.discord = true) ----
DISCORD_WEBHOOK_URL=

# ---- Solana ----
# RPC dedicado (Helius/Triton/QuickNode) recomendado; o público é lento e
# tem rate limit agressivo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Execução LIVE (somente se executor.enabled=true e paperTrading=false) ----
# Chave privada base58 de uma carteira BURNER com fundos mínimos.
# NUNCA use sua carteira principal. NUNCA commite este arquivo.
BURNER_WALLET_PRIVATE_KEY=

# ---- Kill switch ----
# KILL_SWITCH=1 bloqueia qualquer trade imediatamente (alternativa: criar um
# arquivo chamado KILL_SWITCH na raiz do projeto, sem reiniciar o processo).
# KILL_SWITCH=1

# ---- Diversos ----
# LOG_LEVEL=debug
# CONFIG_PATH=config.json
