# ==========================================================================
#  CONFIGURAÇÃO DO BOT DE COPYTRADING DA POLYMARKET
#  Copia este ficheiro para ".env" e preenche os teus valores.
#  NUNCA faças commit do teu .env real — ele contém a tua chave privada.
# ==========================================================================

# --------------------------------------------------------------------------
#  1) CREDENCIAIS DA TUA CARTEIRA (execução)
# --------------------------------------------------------------------------

# Chave privada da carteira que assina as ordens (0x...).
# É a chave que controla os fundos. Guarda-a com o máximo cuidado.
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Endereço que efetivamente detém o USDC na Polymarket.
#  - Se usas login por email/Magic ou a carteira web da Polymarket, este é o
#    teu "Polymarket proxy address" (vê-lo em polymarket.com > Deposit).
#  - Se usas uma EOA simples (MetaMask) e os fundos estão nessa mesma conta,
#    põe aqui o MESMO endereço da tua chave privada.
POLYMARKET_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE

# Tipo de assinatura:
#   0 = EOA normal (MetaMask, hardware wallet) — fundos na própria conta
#   1 = Email / Magic login (proxy wallet)      — o mais comum na web
#   2 = Carteira de browser via proxy
POLYMARKET_SIGNATURE_TYPE=1

# --------------------------------------------------------------------------
#  2) QUEM COPIAR (deteção)
# --------------------------------------------------------------------------

# Lista de carteiras a copiar, separadas por vírgula (endereços 0x...).
# Encontra bons traders no leaderboard: https://polymarket.com/leaderboard
TARGET_WALLETS=0xTRADER1,0xTRADER2

# --------------------------------------------------------------------------
#  3) DIMENSIONAMENTO DA POSIÇÃO (sizing)
# --------------------------------------------------------------------------

# Estratégia de cálculo do tamanho da tua ordem:
#   fixed        -> gastas sempre FIXED_SIZE_USDC por trade copiado
#   proportional -> gastas (tamanho do alvo em USDC) * COPY_RATIO
SIZING_STRATEGY=fixed

# Usado quando SIZING_STRATEGY=fixed. Valor em USDC por trade.
FIXED_SIZE_USDC=5

# Usado quando SIZING_STRATEGY=proportional. Ex.: 0.05 = 5% do que o alvo gastou.
COPY_RATIO=0.05

# --------------------------------------------------------------------------
#  4) GESTÃO DE RISCO
# --------------------------------------------------------------------------

# Máximo em USDC que uma única ordem copiada pode gastar (teto de segurança).
MAX_POSITION_USDC=20

# Máximo em USDC que o bot pode gastar em compras por dia (UTC). 0 = sem limite.
MAX_DAILY_USDC=100

# Ignora trades do alvo abaixo deste valor em USDC (evita copiar "poeira").
MIN_TRADE_USDC=1

# Como reagir quando o alvo VENDE (fecha posição):
#   exit_full    -> vendes TODA a tua posição nesse token (sais quando ele sai)
#   proportional -> vendes uma fração proporcional ao que ele vendeu
#   ignore       -> só copias compras, nunca vendes
SELL_MODE=exit_full

# --------------------------------------------------------------------------
#  5) FILTROS OPCIONAIS DE MERCADO
# --------------------------------------------------------------------------

# Só copia estes conditionId (separados por vírgula). Vazio = todos permitidos.
ALLOWED_CONDITION_IDS=

# Nunca copia estes conditionId (separados por vírgula).
BLOCKED_CONDITION_IDS=

# --------------------------------------------------------------------------
#  6) COMPORTAMENTO DO BOT
# --------------------------------------------------------------------------

# Segundos entre cada verificação da Data API.
POLL_INTERVAL_SECONDS=15

# MODO DE TESTE: se true, o bot deteta e calcula tudo mas NÃO envia ordens reais.
# Começa SEMPRE com true até confiares no comportamento.
DRY_RUN=true

# Endpoints (normalmente não precisas de mudar).
CLOB_HOST=https://clob.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
CHAIN_ID=137

# Caminho do ficheiro de estado (dedup + gasto diário).
STATE_FILE=state.json

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
